# Copy this file to .env and fill in your own values.
# .env is already in .gitignore, so your real keys never get committed.

# classify and compose use Gemini, the loops use Groq.
GEMINI_API_KEY=
# gemini-2.5-flash retires October 16, 2026, confirmed against Google's
# own deprecation schedule, so gemini-3.5-flash is the current default.
GEMINI_MODEL=gemini-3.5-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
